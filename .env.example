# Скопируйте в .env и заполните. .env в git не коммитится.

# ─── Telegram User API (для parsers/chat.py) ───────────────────────────────────────
# https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Номер телефона для авторизации парсера
TG_PHONE=
# ID группы, например -1001234567890
TG_CHAT=

# ─── Telegram Bot (для бота, bot/) ────────────────────────────────────────────────
# Получить у @BotFather командой /newbot
TG_BOT_TOKEN=

# Чаты, где отвечает Лиза (через запятую)
ALLOWED_CHATS=
# Кому можно писать Лизе в личку — только этим пользователям (участники чатов сами по себе не проходят).
# Через запятую: id или id:метка; метка — любой текст, только для логов. Пример: 123456789:@name
ALLOWED_USERS=

# ─── Anthropic ────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY задаётся в окружении хоста (например, в ~/.bashrc), не здесь

# ─── Сеть Claude API ──────────────────────────────────────────────────────────
# HTTP-прокси только для Claude API (пусто — напрямую)
ANTHROPIC_PROXY=http://proxy.example:8080
# Claude используется, только если внешний IP (через прокси) в этой подсети. Обязательно
ALLOWED_SUBNET=203.0.113.0/24

# ─── Пользователи и чаты ──────────────────────────────────────────────────────
# Кому разрешено /delete (username без @, через запятую)
ADMIN_USERNAMES=
# Чат, где работают /pray и /praystats
PRAY_CHAT_ID=
# Пользователи с бонусом /pray (10% на Джинн)
PRAY_BONUS_USERS=
# Молитв /pray в сутки на человека (сброс в 00:00 UTC+3); бонусные за задания — сверх лимита
PRAY_DAILY_LIMIT=1
# Чаты, где по умолчанию обсуждают «Осквернённый Грааль»
TG_PRIORITY_CHATS=
